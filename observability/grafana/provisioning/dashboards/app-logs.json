{
  "title": "App Logs",
  "uid": "app-logs",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Errors + Critical (last 1h)",
      "type": "stat",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(count_over_time({compose_service=\"app\", level=~\"ERROR|CRITICAL\"}[1h]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Warnings (last 1h)",
      "type": "stat",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(count_over_time({compose_service=\"app\", level=\"WARNING\"}[1h]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Log volume by level",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum by (level) (count_over_time({compose_service=\"app\"}[$__interval]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Warning / Error / Critical log stream",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 8 },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "expr": "{compose_service=\"app\", level=~\"WARNING|ERROR|CRITICAL\"}",
          "refId": "A"
        }
      ]
    }
  ]
}
